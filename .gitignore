# Model files. Training output is large and reproducible, so it stays out of
# git -- except the compact model the Streamlit app ships with (~2 MB).
*.keras
*.h5
!models/brain_tumor_cnn.keras

# Keep the model card describing that compact model.
!models/model_card.json

# Logs & plots
*.csv
*.png
*.log

# Streamlit cache
.streamlit/

# System files
.DS_Store

# Decoded image cache written by train_compact.py (~83 MB).
# Regenerated automatically on first run.
.cache_images.npz
